APP_NAME="Matka Live Results API"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matka_db
DB_USERNAME=matka_user
DB_PASSWORD=SecretPass@2026

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=replace_with_a_64_character_random_hex_string_in_production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

DELAYED_PUBLISHING_MINUTES=5
CORS_ALLOWED_ORIGINS=*
